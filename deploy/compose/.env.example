# Copy to ~/.config/moose/secrets/.env.compose and run `make link-secrets`.
# Never commit the real file.

# Tailscale auth key: reusable=false, pre-authorized, tagged tag:moose-hub.
# Only the first boot needs it; tsnet state persists in the moose-data volume.
TS_AUTHKEY=
# Tailnet login allowed to mint the first PAT via POST /v1/bootstrap/token.
MOOSE_BOOTSTRAP_ADMIN=
MOOSE_ENV=prod
