# Copy to backend.tf (gitignored) and set your own state bucket. This root does
# not create the bucket. Native S3 locking needs Terraform >= 1.10.
terraform {
  backend "s3" {
    bucket       = "REPLACE-with-your-tfstate-bucket"
    key          = "moose/dev/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true
  }
}
