# Copy to backend.tf (gitignored). The state bucket is created outside moose and
# this root never creates it. Native S3 locking (use_lockfile) needs Terraform
# >= 1.10, so there is no DynamoDB lock table. Confirm the region against the bucket.
terraform {
  backend "s3" {
    bucket       = "changefabric-tfstate-554340864373"
    key          = "moose/drive/terraform.tfstate"
    region       = "us-east-1"
    profile      = "change-fabric"
    encrypt      = true
    use_lockfile = true
  }
}
